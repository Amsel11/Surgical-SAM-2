# Copy to .env (gitignored) and fill in for your machine.
# python-dotenv loads .env at pipeline startup; Hydra YAML configs reference
# these via ${oc.env:VAR_NAME}.

# ---- Manifest DB (SQLite, source of truth) ----------------------------------
# The clicker, pipeline.cli, and qc tooling all read this. On olab-1 this is
# the local working copy; on bp it's the canonical manifest.
SURGSAM_MANIFEST=/home/schula12/OLAB/MLdir/Surgical-SAM-2/local_manifest.db

# ---- Bigpurple paths --------------------------------------------------------
BP_REPO=/gpfs/data/oermannlab/users/schula12/Surgical-SAM-2
BP_FRAMES_ROOT=/gpfs/data/oermannlab/private_data/whip/frames_attempt2
BP_RESULTS_ROOT=/gpfs/data/oermannlab/users/schula12/Surgical-SAM-2/results

# ---- olab-1 (local) paths ---------------------------------------------------
LOCAL_FRAMES_ROOT=/home/schula12/OLAB/MLdir/Surgical-SAM-2/local_frames
LOCAL_RESULTS_ROOT=/home/schula12/OLAB/MLdir/Surgical-SAM-2/local_results

# ---- Optional integrations (leave blank if unused) --------------------------
WANDB_API_KEY=
WANDB_PROJECT=surgsam2-ablation
WANDB_ENTITY=

# Only needed if downloading SAM3 from a gated Hugging Face repo
HF_TOKEN=
